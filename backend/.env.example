# Backend 环境变量模板
# 复制此文件为 .env 并填入实际值

# ── 应用配置 ──────────────────────────────────────────────────────────
APP_NAME=Agent Document Review
APP_ENV=development
APP_PORT=8000
DEBUG=true

# ── 数据库配置 ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/agent_review

# ── AI / LLM 配置 (DeepSeek) ──────────────────────────────────────────
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── JWT / Auth ────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── 文件存储 ──────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
MAX_FILE_SIZE_MB=50
MAX_PAGE_COUNT=200

# ── CORS ──────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── 其他服务配置 ──────────────────────────────────────────────────────
# REDIS_URL=
# CHECKPOINTER_DB_URL=
